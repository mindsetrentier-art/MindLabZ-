rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper for validating bounded string arrays (e.g. lawsMastered, bookmarks, unlockedBadges, selectedGoals, tags)
    function isValidStringList(listVal, maxLen) {
      return listVal is list
        && listVal.size() <= maxLen
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() >= 1 && listVal[0].size() <= 100));
    }

    // Helper for validating emotion map in CognitiveJournal
    function isValidEmotionMap(emotion) {
      return emotion is map
        && emotion.keys().hasAll(['primary', 'intensity', 'valence'])
        && emotion.primary is string && emotion.primary.size() >= 1 && emotion.primary.size() <= 80
        && emotion.intensity is number && emotion.intensity >= 1 && emotion.intensity <= 10
        && emotion.valence is string && emotion.valence.size() >= 1 && emotion.valence.size() <= 40
        && (!('secondary' in emotion) || (emotion.secondary is string && emotion.secondary.size() <= 80))
        && (!('energyLevel' in emotion) || (emotion.energyLevel is number && emotion.energyLevel >= 1 && emotion.energyLevel <= 5));
    }

    // Blueprint for CognitiveJournal entity
    function isValidCognitiveJournal(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'date',
          'title',
          'templateType',
          'emotion',
          'structuredData',
          'tags',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'date',
          'time',
          'title',
          'templateType',
          'emotion',
          'relatedLawId',
          'relatedLawName',
          'structuredData',
          'tags',
          'insightRating',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 20
        && (!('time' in data) || (data.time is string && data.time.size() <= 20))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.templateType is string && data.templateType.size() >= 1 && data.templateType.size() <= 40
        && isValidEmotionMap(data.emotion)
        && data.structuredData is map && data.structuredData.size() <= 30
        && isValidStringList(data.tags, 10)
        && (!('relatedLawId' in data) || (data.relatedLawId is string && data.relatedLawId.size() <= 60))
        && (!('relatedLawName' in data) || (data.relatedLawName is string && data.relatedLawName.size() <= 100))
        && (!('insightRating' in data) || (data.insightRating is number && data.insightRating >= 1 && data.insightRating <= 5))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Blueprint for FocusSessionBookmark entity
    function isValidFocusSessionBookmark(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'label',
          'timestampSec',
          'binauralPresetId',
          'naturePresetId',
          'beatHz',
          'carrierHz',
          'binauralMix',
          'natureMix',
          'masterVolume',
          'timerDurationSec',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'label',
          'timestampSec',
          'binauralPresetId',
          'naturePresetId',
          'beatHz',
          'carrierHz',
          'binauralMix',
          'natureMix',
          'masterVolume',
          'timerDurationSec',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
        && data.timestampSec is number && data.timestampSec >= 0 && data.timestampSec <= 86400
        && data.binauralPresetId is string && data.binauralPresetId.size() >= 1 && data.binauralPresetId.size() <= 32
        && data.binauralPresetId in ['gamma-40', 'beta-18', 'smr-14', 'alpha-10', 'theta-6']
        && data.naturePresetId is string && data.naturePresetId.size() >= 1 && data.naturePresetId.size() <= 32
        && data.naturePresetId in ['canopy-rain', 'ocean-tide', 'alpine-stream', 'night-hearth', 'none']
        && data.beatHz is number && data.beatHz >= 4 && data.beatHz <= 45
        && data.carrierHz is number && data.carrierHz >= 100 && data.carrierHz <= 320
        && data.binauralMix is number && data.binauralMix >= 0 && data.binauralMix <= 1
        && data.natureMix is number && data.natureMix >= 0 && data.natureMix <= 1
        && data.masterVolume is number && data.masterVolume >= 0 && data.masterVolume <= 1
        && data.timerDurationSec is number && data.timerDurationSec >= 0 && data.timerDurationSec <= 14400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Blueprint for BrainGymSession entity
    function isValidBrainGymSession(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'gameId',
          'gameTitle',
          'category',
          'difficulty',
          'score',
          'accuracy',
          'avgReactionMs',
          'bestReactionMs',
          'maxSpan',
          'roundsCompleted',
          'xpEarned',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'gameId',
          'gameTitle',
          'category',
          'difficulty',
          'score',
          'accuracy',
          'avgReactionMs',
          'bestReactionMs',
          'maxSpan',
          'roundsCompleted',
          'xpEarned',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.gameId is string && data.gameId.size() >= 1 && data.gameId.size() <= 32
        && data.gameId in ['nback-sequence', 'chrono-span', 'reflex-pulse', 'go-nogo-gate']
        && data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 16
        && data.category in ['memory', 'reaction']
        && data.difficulty is string && data.difficulty.size() >= 1 && data.difficulty.size() <= 16
        && data.difficulty in ['standard', 'intense', 'master']
        && data.score is number && data.score >= 0 && data.score <= 1000000
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.avgReactionMs is number && data.avgReactionMs >= 0 && data.avgReactionMs <= 10000
        && data.bestReactionMs is number && data.bestReactionMs >= 0 && data.bestReactionMs <= 10000
        && data.maxSpan is number && data.maxSpan >= 0 && data.maxSpan <= 32
        && data.roundsCompleted is number && data.roundsCompleted >= 0 && data.roundsCompleted <= 200
        && data.xpEarned is number && data.xpEarned >= 0 && data.xpEarned <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Blueprint for LawMarginaliaNote entity
    function isValidLawMarginaliaNote(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'lawId',
          'pageIndex',
          'content',
          'inkColor',
          'handwritingStyle',
          'anchorZone',
          'tiltDeg',
          'sourceMode',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'lawId',
          'pageIndex',
          'content',
          'inkColor',
          'handwritingStyle',
          'anchorZone',
          'tiltDeg',
          'sourceMode',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.lawId is string && data.lawId.size() >= 1 && data.lawId.size() <= 128 && data.lawId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.pageIndex is number && data.pageIndex >= 0 && data.pageIndex <= 11
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 800
        && data.inkColor is string && data.inkColor in ['sepia', 'crimson', 'indigo', 'emerald']
        && data.handwritingStyle is string && data.handwritingStyle in ['cursive', 'running', 'archival']
        && data.anchorZone is string && data.anchorZone in ['top-margin', 'side-margin', 'bottom-margin']
        && data.tiltDeg is number && data.tiltDeg >= -5 && data.tiltDeg <= 5
        && data.sourceMode is string && data.sourceMode in ['typed', 'dictated']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Pillar 2: Standalone Entity Validation Blueprint for LawPageBookmark
    function isValidLawPageBookmark(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'lawId',
          'lawNameZh',
          'lawNameEn',
          'categoryZh',
          'pageIndex',
          'pageTitle',
          'bookmarkKind',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'lawId',
          'lawNameZh',
          'lawNameEn',
          'categoryZh',
          'pageIndex',
          'pageTitle',
          'bookmarkKind',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.lawId is string && data.lawId.size() >= 1 && data.lawId.size() <= 128 && data.lawId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.lawNameZh is string && data.lawNameZh.size() >= 1 && data.lawNameZh.size() <= 120
        && data.lawNameEn is string && data.lawNameEn.size() <= 160
        && data.categoryZh is string && data.categoryZh.size() >= 1 && data.categoryZh.size() <= 40
        && data.pageIndex is number && data.pageIndex >= 0 && data.pageIndex <= 11
        && data.pageTitle is string && data.pageTitle.size() >= 1 && data.pageTitle.size() <= 80
        && data.bookmarkKind is string && data.bookmarkKind in ['progress', 'page-pin']
        && data.note is string && data.note.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Pillar 2: Standalone Entity Validation Blueprint for LawReviewSchedule
    function isValidLawReviewSchedule(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'lawId',
          'lawNameZh',
          'lawNameEn',
          'categoryZh',
          'easeFactor',
          'intervalDays',
          'repetitions',
          'lapses',
          'totalReviews',
          'lastRating',
          'nextReviewAtMs',
          'lastReviewedAtMs',
          'snoozedUntilMs',
          'notificationsEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'lawId',
          'lawNameZh',
          'lawNameEn',
          'categoryZh',
          'easeFactor',
          'intervalDays',
          'repetitions',
          'lapses',
          'totalReviews',
          'lastRating',
          'nextReviewAtMs',
          'lastReviewedAtMs',
          'snoozedUntilMs',
          'notificationsEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.lawId is string && data.lawId.size() >= 1 && data.lawId.size() <= 128 && data.lawId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.id == data.lawId
        && data.lawNameZh is string && data.lawNameZh.size() >= 1 && data.lawNameZh.size() <= 120
        && data.lawNameEn is string && data.lawNameEn.size() <= 160
        && data.categoryZh is string && data.categoryZh.size() >= 1 && data.categoryZh.size() <= 40
        && data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 3.5
        && data.intervalDays is number && data.intervalDays >= 0 && data.intervalDays <= 3650
        && data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 1000
        && data.lapses is number && data.lapses >= 0 && data.lapses <= 1000
        && data.totalReviews is number && data.totalReviews >= 0 && data.totalReviews <= 5000
        && data.lastRating is string && data.lastRating in ['none', 'again', 'hard', 'good', 'easy']
        && data.nextReviewAtMs is number && data.nextReviewAtMs >= 0 && data.nextReviewAtMs <= 4102444800000
        && data.lastReviewedAtMs is number && data.lastReviewedAtMs >= 0 && data.lastReviewedAtMs <= 4102444800000
        && data.snoozedUntilMs is number && data.snoozedUntilMs >= 0 && data.snoozedUntilMs <= 4102444800000
        && data.notificationsEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Pillar 2: Standalone Entity Validation Blueprint for GameLeaderboardEntry
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'userName',
          'userAvatar',
          'userTitle',
          'userLevel',
          'gameId',
          'gameName',
          'score',
          'accuracy',
          'streak',
          'date',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'userName',
          'userAvatar',
          'userTitle',
          'userLevel',
          'gameId',
          'gameName',
          'score',
          'accuracy',
          'streak',
          'date',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
        && data.userAvatar is string && data.userAvatar.size() >= 1 && data.userAvatar.size() <= 1000
        && data.userTitle is string && data.userTitle.size() >= 1 && data.userTitle.size() <= 60
        && data.userLevel is number && data.userLevel >= 1 && data.userLevel <= 1000
        && data.gameId is string && data.gameId.size() >= 1 && data.gameId.size() <= 60
        && data.gameName is string && data.gameName.size() >= 1 && data.gameName.size() <= 100
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.streak is number && data.streak >= 0 && data.streak <= 10000
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Helper for validating the 5-dimensional cognitive stats map
    function isValidStatsMap(stats) {
      return stats is map
        && stats.keys().hasAll(['memory', 'attention', 'reasoning', 'knowledge', 'decision'])
        && stats.keys().hasOnly(['memory', 'attention', 'reasoning', 'knowledge', 'decision'])
        && stats.memory is number && stats.memory >= 0 && stats.memory <= 100
        && stats.attention is number && stats.attention >= 0 && stats.attention <= 100
        && stats.reasoning is number && stats.reasoning >= 0 && stats.reasoning <= 100
        && stats.knowledge is number && stats.knowledge >= 0 && stats.knowledge <= 100
        && stats.decision is number && stats.decision >= 0 && stats.decision <= 100;
    }

    // Helper for validating weeklyActivity bounded list
    function isValidWeeklyActivity(activity) {
      return activity is list
        && activity.size() <= 14
        && (
          activity.size() == 0 || (
            activity[0] is map
            && activity[0].keys().hasAll(['day', 'date', 'minutes', 'xp', 'completed'])
            && activity[0].keys().hasOnly(['day', 'date', 'minutes', 'xp', 'completed'])
            && activity[0].day is string && activity[0].day.size() >= 1 && activity[0].day.size() <= 20
            && activity[0].date is string && activity[0].date.size() >= 1 && activity[0].date.size() <= 20
            && activity[0].minutes is number && activity[0].minutes >= 0 && activity[0].minutes <= 1440
            && activity[0].xp is number && activity[0].xp >= 0 && activity[0].xp <= 100000
            && activity[0].completed is bool
          )
        );
    }

    // Pillar 2: Standalone Entity Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'avatar',
          'title',
          'level',
          'xp',
          'streak',
          'lastActiveDate',
          'totalGames',
          'totalQuizzes',
          'quizPoints',
          'lawsMastered',
          'lawMasteryMap',
          'bookmarks',
          'gameHighScores',
          'unlockedBadges',
          'selectedGoals',
          'hasCompletedOnboarding',
          'isDailyChallengeCompleted',
          'stats',
          'weeklyActivity',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'avatar',
          'title',
          'level',
          'xp',
          'streak',
          'lastActiveDate',
          'totalGames',
          'totalQuizzes',
          'quizPoints',
          'lawsMastered',
          'lawMasteryMap',
          'bookmarks',
          'gameHighScores',
          'unlockedBadges',
          'selectedGoals',
          'hasCompletedOnboarding',
          'isDailyChallengeCompleted',
          'completedGames',
          'gameCompletionCount',
          'stats',
          'weeklyActivity',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 1000
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
        && data.level is number && data.level >= 1 && data.level <= 1000
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.streak is number && data.streak >= 0 && data.streak <= 10000
        && data.lastActiveDate is string && data.lastActiveDate.size() >= 1 && data.lastActiveDate.size() <= 20
        && data.totalGames is number && data.totalGames >= 0 && data.totalGames <= 1000000
        && data.totalQuizzes is number && data.totalQuizzes >= 0 && data.totalQuizzes <= 1000000
        && data.quizPoints is number && data.quizPoints >= 0 && data.quizPoints <= 10000000
        && isValidStringList(data.lawsMastered, 120)
        && data.lawMasteryMap is map && data.lawMasteryMap.size() <= 120
        && isValidStringList(data.bookmarks, 120)
        && data.gameHighScores is map && data.gameHighScores.size() <= 50
        && isValidStringList(data.unlockedBadges, 50)
        && isValidStringList(data.selectedGoals, 20)
        && (!('completedGames' in data) || isValidStringList(data.completedGames, 100))
        && (!('gameCompletionCount' in data) || (data.gameCompletionCount is map && data.gameCompletionCount.size() <= 50))
        && data.hasCompletedOnboarding is bool
        && data.isDailyChallengeCompleted is bool
        && isValidStatsMap(data.stats)
        && isValidWeeklyActivity(data.weeklyActivity)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Action-Based Update Helpers
    function isProfilePreferencesAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'name',
        'avatar',
        'title',
        'selectedGoals',
        'hasCompletedOnboarding',
        'updatedAt'
      ]);
    }

    function isTrainingProgressSyncAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'name',
        'avatar',
        'title',
        'level',
        'xp',
        'streak',
        'lastActiveDate',
        'totalGames',
        'totalQuizzes',
        'quizPoints',
        'lawsMastered',
        'lawMasteryMap',
        'bookmarks',
        'gameHighScores',
        'unlockedBadges',
        'selectedGoals',
        'hasCompletedOnboarding',
        'isDailyChallengeCompleted',
        'completedGames',
        'gameCompletionCount',
        'stats',
        'weeklyActivity',
        'updatedAt'
      ]);
    }

    function isFocusBookmarkUpdateAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'label',
        'timestampSec',
        'binauralPresetId',
        'naturePresetId',
        'beatHz',
        'carrierHz',
        'binauralMix',
        'natureMix',
        'masterVolume',
        'timerDurationSec',
        'updatedAt'
      ]);
    }

    function isLawMarginaliaUpdateAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'content',
        'inkColor',
        'handwritingStyle',
        'anchorZone',
        'tiltDeg',
        'sourceMode',
        'updatedAt'
      ]);
    }

    function isLawPageBookmarkUpdateAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'pageIndex',
        'pageTitle',
        'note',
        'lawNameZh',
        'lawNameEn',
        'categoryZh',
        'updatedAt'
      ]);
    }

    function isLawReviewScheduleUpdateAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'lawNameZh',
        'lawNameEn',
        'categoryZh',
        'easeFactor',
        'intervalDays',
        'repetitions',
        'lapses',
        'totalReviews',
        'lastRating',
        'nextReviewAtMs',
        'lastReviewedAtMs',
        'snoozedUntilMs',
        'notificationsEnabled',
        'updatedAt'
      ]);
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidUserProfile(incoming())
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isProfilePreferencesAction() ||
          isTrainingProgressSyncAction()
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // Subcollection: /users/{userId}/cognitiveJournals/{journalId}
      match /cognitiveJournals/{journalId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(journalId)
          && incoming().id == journalId
          && incoming().userId == userId
          && isValidCognitiveJournal(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isOwner(userId)
          && isValidId(journalId)
          && incoming().id == journalId
          && incoming().userId == userId
          && isValidCognitiveJournal(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if isOwner(userId) && isValidId(journalId);
      }

      // Subcollection: /users/{userId}/focusSessionBookmarks/{bookmarkId}
      match /focusSessionBookmarks/{bookmarkId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(bookmarkId)
          && incoming().id == bookmarkId
          && incoming().userId == userId
          && isValidFocusSessionBookmark(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidFocusSessionBookmark(incoming())
          && isOwner(userId)
          && isValidId(bookmarkId)
          && incoming().id == bookmarkId
          && incoming().userId == userId
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isFocusBookmarkUpdateAction();

        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }

      // Subcollection: /users/{userId}/brainGymSessions/{sessionId}
      match /brainGymSessions/{sessionId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(sessionId)
          && incoming().id == sessionId
          && incoming().userId == userId
          && isValidBrainGymSession(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Subcollection: /users/{userId}/lawMarginalia/{noteId}
      match /lawMarginalia/{noteId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && incoming().userId == userId
          && isValidLawMarginaliaNote(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidLawMarginaliaNote(incoming())
          && isOwner(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && incoming().userId == userId
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().lawId == existing().lawId
          && incoming().pageIndex == existing().pageIndex
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isLawMarginaliaUpdateAction();

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Subcollection: /users/{userId}/lawPageBookmarks/{bookmarkId}
      match /lawPageBookmarks/{bookmarkId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(bookmarkId)
          && incoming().id == bookmarkId
          && incoming().userId == userId
          && isValidLawPageBookmark(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidLawPageBookmark(incoming())
          && isOwner(userId)
          && isValidId(bookmarkId)
          && incoming().id == bookmarkId
          && incoming().userId == userId
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().lawId == existing().lawId
          && incoming().bookmarkKind == existing().bookmarkKind
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isLawPageBookmarkUpdateAction();

        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }

      // Subcollection: /users/{userId}/lawReviewSchedules/{lawId}
      match /lawReviewSchedules/{lawId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(lawId)
          && incoming().id == lawId
          && incoming().lawId == lawId
          && incoming().userId == userId
          && isValidLawReviewSchedule(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidLawReviewSchedule(incoming())
          && isOwner(userId)
          && isValidId(lawId)
          && incoming().id == lawId
          && incoming().lawId == lawId
          && incoming().userId == userId
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().lawId == existing().lawId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isLawReviewScheduleUpdateAction();

        allow delete: if isOwner(userId) && isValidId(lawId);
      }
    }

    // Collection: /gameLeaderboards/{scoreId}
    match /gameLeaderboards/{scoreId} {
      allow get, list: if true;

      allow create: if isVerifiedUser()
        && isValidId(scoreId)
        && incoming().id == scoreId
        && incoming().userId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(scoreId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isValidLeaderboardEntry(incoming());

      allow delete: if isVerifiedUser()
        && isValidId(scoreId)
        && existing().userId == request.auth.uid;
    }
  }
}
