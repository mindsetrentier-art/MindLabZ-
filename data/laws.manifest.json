  "laws": [
    { "id": "LAW001", "title_zh": "确认偏误", "title_en": "Confirmation Bias", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Easy", "xp": 20, "summary": "人们倾向于寻找、信任和记住支持自己既有信念的信息，而本能过滤相反证据。" },
    { "id": "LAW002", "title_zh": "首因效应", "title_en": "Primacy Effect", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Easy", "xp": 20, "summary": "最先呈现的信息在总体印象形成与记忆编码中占据显著主导权重。" },
    { "id": "LAW003", "title_zh": "近因效应", "title_en": "Recency Effect", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Easy", "xp": 20, "summary": "最新、最后出现的信息在短期工作记忆中最清晰，对即时判断影响强烈。" },
    { "id": "LAW004", "title_zh": "光环效应", "title_en": "Halo Effect", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Easy", "xp": 20, "summary": "对某人或某事物某一突出特质的正面评价，会泛化延伸到其整体品质判断。" },
    { "id": "LAW005", "title_zh": "可得性启发", "title_en": "Availability Heuristic", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Medium", "xp": 25, "summary": "大脑根据某件事在脑海中浮现的容易程度，来草率评估其真实发生概率。" },
    { "id": "LAW006", "title_zh": "代表性启发", "title_en": "Representativeness Heuristic", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Medium", "xp": 25, "summary": "仅凭事物与刻板原型的表面相似度下判断，而忽略基础比率与样本规模。" },
    { "id": "LAW007", "title_zh": "框架效应", "title_en": "Framing Effect", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Medium", "xp": 25, "summary": "同一客观事实采用“收益框架”或“损失框架”表述，会引发截然相反的决策。" },
    { "id": "LAW008", "title_zh": "锚定效应", "title_en": "Anchoring Effect", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Easy", "xp": 20, "summary": "在做定量估值时过度依赖最初接收到的第一笔数字（锚点），导致后续调整不足。" },
    { "id": "LAW009", "title_zh": "达克效应", "title_en": "Dunning-Kruger Effect", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Easy", "xp": 20, "summary": "能力欠缺者因缺乏元认知能力而高估自身水平，而专家往往低估自身相对优势。" },
    { "id": "LAW010", "title_zh": "后见之明偏误", "title_en": "Hindsight Bias", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Easy", "xp": 20, "summary": "事件发生后，人们倾向于高估自己在事前预测该事件结果的准确性（事后诸葛亮）。" },
    { "id": "LAW011", "title_zh": "蔡格尼克效应", "title_en": "Zeigarnik Effect", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "人们对未完成或中途被打断的任务记忆，远比已完成任务更深刻持久。" },
    { "id": "LAW012", "title_zh": "峰终定律", "title_en": "Peak-End Rule", "category": "情绪", "chapter": "02 记忆机制与注意力科学", "difficulty": "Easy", "xp": 20, "summary": "人们对一段体验的记忆评估主要由最强烈的峰值时刻与结束时的感受决定。" },
    { "id": "LAW013", "title_zh": "斯特鲁普效应", "title_en": "Stroop Effect", "category": "认知", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "当字义与印刷颜色冲突时，自动化阅读会干扰颜色识别，导致反应延迟。" },
    { "id": "LAW014", "title_zh": "损失厌恶", "title_en": "Loss Aversion", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Medium", "xp": 25, "summary": "面对同等规模的得失，失去带来的痛苦感约是获得快乐感的2到2.5倍。" },
    { "id": "LAW015", "title_zh": "沉没成本效应", "title_en": "Sunk Cost Effect", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Easy", "xp": 20, "summary": "因不愿承认前期已付出的不可收回成本，而在错误方向上继续追加投入。" },
    { "id": "LAW016", "title_zh": "禀赋效应", "title_en": "Endowment Effect", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Medium", "xp": 25, "summary": "一旦拥有某件物品，人们对其估价就会瞬间高于未拥有时的购买意愿价格。" },
    { "id": "LAW017", "title_zh": "现状偏误", "title_en": "Status Quo Bias", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Easy", "xp": 20, "summary": "面对改变带来的不确定性，人们非理性地偏好维持现状与默认选项。" },
    { "id": "LAW018", "title_zh": "选择过载效应", "title_en": "Choice Overload", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Easy", "xp": 20, "summary": "备选方案过多会急剧增加认知负荷与后悔预期，导致决策瘫痪与满意度下降。" },
    { "id": "LAW019", "title_zh": "心理账户", "title_en": "Mental Accounting", "category": "决策", "chapter": "05 消费心理与商业定价", "difficulty": "Medium", "xp": 25, "summary": "人们在心里把客观等值的金钱按来源或用途分门别类，采取非理性的花销标准。" },
    { "id": "LAW020", "title_zh": "双曲贴现", "title_en": "Hyperbolic Discounting", "category": "决策", "chapter": "03 决策心理学与风险博弈", "difficulty": "Hard", "xp": 30, "summary": "人们过度偏好即时小奖赏，而对远期大收益赋予极高折现率，导致短视与拖延。" },
    { "id": "LAW021", "title_zh": "艾宾浩斯遗忘曲线", "title_en": "Ebbinghaus Forgetting Curve", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Easy", "xp": 20, "summary": "记忆遗忘在学习后最初阶段最快，随后放缓，间隔重复可有效重塑长期记忆。" },
    { "id": "LAW022", "title_zh": "组块化记忆", "title_en": "Chunking Principle", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "工作记忆容量约为4~7个单元，将零散信息编码为有意义的组块可突破记忆瓶颈。" },
    { "id": "LAW023", "title_zh": "鸡尾酒会效应", "title_en": "Cocktail Party Effect", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Easy", "xp": 20, "summary": "在嘈杂环境中大脑能选择性聚焦特定对话，但对自身名字等高唤醒词保持自动捕捉。" },
    { "id": "LAW024", "title_zh": "非注意盲视", "title_en": "Inattentional Blindness", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "当注意力高度集中于特定任务时，会对视野中显而易见的异常物体完全视而不见。" },
    { "id": "LAW025", "title_zh": "冯·雷斯托夫隔离效应", "title_en": "Von Restorff Effect", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "在同质化列表中，具有显著视觉或语义差异的孤立项最容易被大脑优先记住。" },
    { "id": "LAW026", "title_zh": "生成效应", "title_en": "Generation Effect", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "通过自己主动提取、复述和整合生成的信息，比被动阅读的信息记忆牢固数倍。" },
    { "id": "LAW027", "title_zh": "情绪一致性记忆", "title_en": "Mood-Congruent Memory", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "人们更容易提取与当前情绪状态极性相匹配的往事记忆。" },
    { "id": "LAW028", "title_zh": "闪光灯记忆", "title_en": "Flashbulb Memory", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "高情绪唤醒事件会让人对当时的情境细节产生极强主观确信感，但细节仍可能失真。" },
    { "id": "LAW029", "title_zh": "错误记忆植入", "title_en": "False Memory Effect", "category": "记忆", "chapter": "02 记忆机制与注意力科学", "difficulty": "Hard", "xp": 30, "summary": "事后诱导性提问或想象重构可以篡改原始记忆痕迹，植入从未发生过的虚假记忆。" },
    { "id": "LAW030", "title_zh": "认知负荷理论", "title_en": "Cognitive Load Theory", "category": "认知", "chapter": "02 记忆机制与注意力科学", "difficulty": "Medium", "xp": 25, "summary": "工作记忆处理能力有限，减少外在冗余负荷才能将资源留给核心图式建构。" },
    { "id": "LAW031", "title_zh": "互惠原理", "title_en": "Reciprocity Principle", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "接受他人微小恩惠后会产生强烈的心理亏欠感，驱使个体做出更大规模的回报。" },
    { "id": "LAW032", "title_zh": "承诺与一致原理", "title_en": "Commitment and Consistency", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Medium", "xp": 25, "summary": "一旦做出公开立场或微小承诺，人们会为了维持自我形象一致而持续履约。" },
    { "id": "LAW033", "title_zh": "社会认同原理", "title_en": "Social Proof", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "在不确定情境下，人们倾向于观察并效仿大多数人或相似群体的行为方式。" },
    { "id": "LAW034", "title_zh": "脚在门槛效应", "title_en": "Foot-in-the-Door Technique", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "先让对方答应一个极小的请求，能显著提高其随后接受更大请求的概率。" },
    { "id": "LAW035", "title_zh": "留面子效应", "title_en": "Door-in-the-Face Technique", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Medium", "xp": 25, "summary": "先提出一个必定被拒的极端大要求，再退让提出真正的小目标，对方更容易妥协接受。" },
    { "id": "LAW036", "title_zh": "权威服从效应", "title_en": "Authority Bias", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Medium", "xp": 25, "summary": "人们对头衔、制服或权威身份的指令倾向于降低批判性审视并本能服从。" },
    { "id": "LAW037", "title_zh": "稀缺效应", "title_en": "Scarcity Heuristic", "category": "商业", "chapter": "05 消费心理与商业定价", "difficulty": "Easy", "xp": 20, "summary": "当物品数量受限或限时供应时，大脑会因害怕失去自由选择权而高估其价值。" },
    { "id": "LAW038", "title_zh": "富兰克林效应", "title_en": "Ben Franklin Effect", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Medium", "xp": 25, "summary": "请求别人帮你一个小忙，反而会让对方为了消除认知失调而更加喜欢你。" },
    { "id": "LAW039", "title_zh": "诱饵效应", "title_en": "Decoy Effect", "category": "决策", "chapter": "05 消费心理与商业定价", "difficulty": "Easy", "xp": 20, "summary": "引入一个不对称劣势的第三选项（诱饵），能显著引导消费者转向高利润目标项。" },
    { "id": "LAW040", "title_zh": "宜家效应", "title_en": "IKEA Effect", "category": "行为", "chapter": "05 消费心理与商业定价", "difficulty": "Easy", "xp": 20, "summary": "消费者对自己倾注了劳动或亲手参与组装的产品，会产生显著偏高的主观价值评估。" },
    { "id": "LAW041", "title_zh": "妥协效应", "title_en": "Compromise Effect", "category": "决策", "chapter": "05 消费心理与商业定价", "difficulty": "Easy", "xp": 20, "summary": "面对高、中、低三档配置时，大多数消费者为了规避极端风险而倾向选择中间档。" },
    { "id": "LAW042", "title_zh": "免费零价格效应", "title_en": "Zero-Price Effect", "category": "决策", "chapter": "05 消费心理与商业定价", "difficulty": "Medium", "xp": 25, "summary": "当价格降为0（免费）时，需求激增幅度远超正常线性折扣，大脑完全忽略隐性成本。" },
    { "id": "LAW043", "title_zh": "支付痛感钝化", "title_en": "Pain of Paying", "category": "决策", "chapter": "05 消费心理与商业定价", "difficulty": "Medium", "xp": 25, "summary": "移动支付、信用卡与筹码将消费与付现解耦，削弱脑岛皮层支付痛感，诱发超支。" },
    { "id": "LAW044", "title_zh": "凡勃伦炫耀效应", "title_en": "Veblen Effect", "category": "社会", "chapter": "05 消费心理与商业定价", "difficulty": "Medium", "xp": 25, "summary": "对于象征社会地位的奢侈品，价格越高反而越能激发身份展示型购买需求。" },
    { "id": "LAW045", "title_zh": "左位数字效应", "title_en": "Left-Digit Effect", "category": "认知", "chapter": "05 消费心理与商业定价", "difficulty": "Easy", "xp": 20, "summary": "大脑从左向右处理数字，19.99元比20.00元在感知上便宜了整整一个量级。" },
    { "id": "LAW046", "title_zh": "登门槛溢价（狄德罗效应）", "title_en": "Diderot Effect", "category": "行为", "chapter": "05 消费心理与商业定价", "difficulty": "Medium", "xp": 25, "summary": "获得一件全新高端物品后，会因原有的配套物品显得格格不入而引发连锁消费升级。" },
    { "id": "LAW047", "title_zh": "聚光灯效应", "title_en": "Spotlight Effect", "category": "社会", "chapter": "06 情绪调节与压力应对", "difficulty": "Easy", "xp": 20, "summary": "人们普遍高估周围他人对自己外貌、失误和言行的关注程度。" },
    { "id": "LAW048", "title_zh": "透明度错觉", "title_en": "Illusion of Transparency", "category": "社会", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "人们高估自己内心紧张、谎言或情绪波动被外人看穿的程度。" },
    { "id": "LAW049", "title_zh": "旁观者效应", "title_en": "Bystander Effect", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Easy", "xp": 20, "summary": "紧急事件现场在场人数越多，责任越被分散，单个个体挺身施救的概率反而越低。" },
    { "id": "LAW050", "title_zh": "基本归因错误", "title_en": "Fundamental Attribution Error", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Medium", "xp": 25, "summary": "解释他人失误时过度归咎于其性格人品，解释自己失误时则归咎于外部环境压力。" },
    { "id": "LAW051", "title_zh": "自利性归因偏误", "title_en": "Self-Serving Bias", "category": "认知", "chapter": "10 自我认知与心智成长", "difficulty": "Easy", "xp": 20, "summary": "人们倾向于把成功归功于自身努力与天赋，而把失败推卸给运气或外部因素。" },
    { "id": "LAW052", "title_zh": "认知失调理论", "title_en": "Cognitive Dissonance", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Medium", "xp": 25, "summary": "当行为与态度冲突时产生心理张力，人们常通过修改态度或自我合理化来缓解不适。" },
    { "id": "LAW053", "title_zh": "曝光效应（熟识偏爱）", "title_en": "Mere-Exposure Effect", "category": "情绪", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "仅仅因为某个面孔、符号或观点反复出现而变得熟悉，大脑就会对其产生更高好感。" },
    { "id": "LAW054", "title_zh": "出丑效应（仰巴脚效应）", "title_en": "Pratfall Effect", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "能力出众者偶发无伤大雅的小失误，反而会打破距离感，使其显得更真实讨喜。" },
    { "id": "LAW055", "title_zh": "皮格马利翁效应", "title_en": "Pygmalion Effect", "category": "社会", "chapter": "08 职场管理与组织行为", "difficulty": "Easy", "xp": 20, "summary": "高期待会通过微妙的赞许、反馈与资源倾斜，最终促使被期待者真正取得高成就。" },
    { "id": "LAW056", "title_zh": "戈莱姆效应", "title_en": "Golem Effect", "category": "社会", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "上级或教师对个体的低预期会引发消极互动，导致对方表现真的持续恶化。" },
    { "id": "LAW057", "title_zh": "霍桑效应", "title_en": "Hawthorne Effect", "category": "行为", "chapter": "08 职场管理与组织行为", "difficulty": "Easy", "xp": 20, "summary": "当人们意识到自己正在被观察或受到特别关注时，会短暂提升工作努力度与表现。" },
    { "id": "LAW058", "title_zh": "安慰剂效应", "title_en": "Placebo Effect", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Easy", "xp": 20, "summary": "对有效干预的坚定积极信念可触发大脑内源性阿片肽与多巴胺释放，产生真实改善。" },
    { "id": "LAW059", "title_zh": "反安慰剂效应", "title_en": "Nocebo Effect", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "对副作用或负面后果的强烈恐惧预期，会真正诱发躯体不适与焦虑反应。" },
    { "id": "LAW060", "title_zh": "巴纳姆效应", "title_en": "Barnum Effect", "category": "认知", "chapter": "01 认知偏误与思维捷径", "difficulty": "Easy", "xp": 20, "summary": "人们极易相信笼统、放之四海皆准的人格描述是专为自己量身定制的精准画像。" },
    { "id": "LAW061", "title_zh": "幸存者偏差", "title_en": "Survivorship Bias", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Easy", "xp": 20, "summary": "只看到经过筛选留存下来的成功样本，而忽略庞大沉默的失败分母，导致归因谬误。" },
    { "id": "LAW062", "title_zh": "基率忽视", "title_en": "Base Rate Fallacy", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Hard", "xp": 30, "summary": "在判断条件概率时，被具体细节描述吸引，而完全忽略总体先验基础概率。" },
    { "id": "LAW063", "title_zh": "合取谬误", "title_en": "Conjunction Fallacy", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Hard", "xp": 30, "summary": "误以为两个事件同时发生的联合概率高于其中单一事件发生的概率（琳达问题）。" },
    { "id": "LAW064", "title_zh": "小数定律偏误", "title_en": "Law of Small Numbers", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Medium", "xp": 25, "summary": "误以为极小样本也必然完美反映总体概率分布，从而对短期随机波动过度解读。" },
    { "id": "LAW065", "title_zh": "均值回归忽视", "title_en": "Regression to the Mean", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Hard", "xp": 30, "summary": "极端高分或极端糟糕表现后自然向平均水平回落，常被错误归因于奖惩干预。" },
    { "id": "LAW066", "title_zh": "赌徒谬误", "title_en": "Gambler's Fallacy", "category": "决策", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Easy", "xp": 20, "summary": "在独立随机事件中，误以为连续出现多次正面后下一次出现反面的概率会增大。" },
    { "id": "LAW067", "title_zh": "热手谬误", "title_en": "Hot-Hand Fallacy", "category": "决策", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Medium", "xp": 25, "summary": "经历连续成功后，过度相信随机过程中的“手气连胜状态”会持续下去。" },
    { "id": "LAW068", "title_zh": "控制错觉", "title_en": "Illusion of Control", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Medium", "xp": 25, "summary": "人们高估个人操作或意志对纯随机事件（如掷骰子、股市短期震荡）的掌控力。" },
    { "id": "LAW069", "title_zh": "乐观偏误", "title_en": "Optimism Bias", "category": "认知", "chapter": "07 概率直觉与逻辑盲区", "difficulty": "Easy", "xp": 20, "summary": "系统性低估自己遭遇负面风险的概率，高估未来顺遂程度。" },
    { "id": "LAW070", "title_zh": "规划谬误", "title_en": "Planning Fallacy", "category": "决策", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "在预估项目工期与成本时总是按最理想情景推算，忽略历史延误经验。" },
    { "id": "LAW071", "title_zh": "帕金森定律", "title_en": "Parkinson's Law", "category": "行为", "chapter": "08 职场管理与组织行为", "difficulty": "Easy", "xp": 20, "summary": "工作会自动膨胀，直到占满为完成它所分配的全部可用时间。" },
    { "id": "LAW072", "title_zh": "彼得原理", "title_en": "Peter Principle", "category": "社会", "chapter": "08 职场管理与组织行为", "difficulty": "Easy", "xp": 20, "summary": "在层级组织中，员工往往依据过往表现被一路晋升，直到抵达其不能胜任的职位。" },
    { "id": "LAW073", "title_zh": "林格尔曼效应（社会懈怠）", "title_en": "Ringelmann Effect", "category": "社会", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "团队协作人数越多，个体付出的平均努力程度反而随责任稀释而下降。" },
    { "id": "LAW074", "title_zh": "古德哈特定律", "title_en": "Goodhart's Law", "category": "决策", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "当一个测量指标被当作考核目标本身时，人们就会针对指标钻空子，使其丧失衡量价值。" },
    { "id": "LAW075", "title_zh": "眼镜蛇效应", "title_en": "Cobra Effect", "category": "决策", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "设计不当的激励机制不仅未能解决问题，反而诱发人们人为制造问题以套取奖励。" },
    { "id": "LAW076", "title_zh": "自行车棚效应（帕金森琐碎定理）", "title_en": "Law of Triviality", "category": "决策", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "会议中人们对极复杂重大议题迅速通过，却在人人都懂的鸡毛蒜皮小事上争论不休。" },
    { "id": "LAW077", "title_zh": "德西效应（过度理由效应）", "title_en": "Overjustification Effect", "category": "行为", "chapter": "08 职场管理与组织行为", "difficulty": "Medium", "xp": 25, "summary": "对原本充满内在兴趣的活动施加不当物质奖励，会将内在动机异化并削弱为外在动机。" },
    { "id": "LAW078", "title_zh": "目标梯度效应", "title_en": "Goal-Gradient Effect", "category": "行为", "chapter": "05 消费心理与商业定价", "difficulty": "Easy", "xp": 20, "summary": "距离目标终点越近，个体的行动加速感与投入动力越强烈（如集章卡预盖两枚章）。" },
    { "id": "LAW079", "title_zh": "耶基斯-多德森定律", "title_en": "Yerkes-Dodson Law", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "唤醒压力水平与任务表现呈倒U型曲线关系，适度焦虑有助于发挥，过度高压则导致崩溃。" },
    { "id": "LAW080", "title_zh": "阿希从众效应", "title_en": "Asch Conformity Effect", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Easy", "xp": 20, "summary": "面对群体一致的错误意见，个体常因害怕被孤立而违背自己的感官事实选择附和。" },
    { "id": "LAW081", "title_zh": "群体思维", "title_en": "Groupthink", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Medium", "xp": 25, "summary": "高凝聚力团体为了维持表面和谐一致，压制异议与批判评估，导致极端糟糕的集体决策。" },
    { "id": "LAW082", "title_zh": "阿比林悖论", "title_en": "Abilene Paradox", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Hard", "xp": 30, "summary": "群体成员各自误以为别人都赞同某提案而不敢反对，最终集体做出所有人都讨厌的决定。" },
    { "id": "LAW083", "title_zh": "群体极化", "title_en": "Group Polarization", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Medium", "xp": 25, "summary": "观点相近的群体经过内部讨论后，其整体立场会比讨论前更加极端和激进。" },
    { "id": "LAW084", "title_zh": "虚假同感偏误", "title_en": "False Consensus Effect", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Easy", "xp": 20, "summary": "人们普遍高估自己的习惯、价值观和信念在大众中的普遍认同比例。" },
    { "id": "LAW085", "title_zh": "内群体偏爱", "title_en": "In-Group Favoritism", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Easy", "xp": 20, "summary": "哪怕基于极其微不足道的分类标签，人们也会本能地在资源分配与评价上偏袒“自己人”。" },
    { "id": "LAW086", "title_zh": "破窗效应", "title_en": "Broken Windows Theory", "category": "社会", "chapter": "09 群体心理与社会规范", "difficulty": "Easy", "xp": 20, "summary": "环境中微小失序与违规若不及时修复，会传递“无人监管”信号，诱发大规模失范行为。" },
    { "id": "LAW087", "title_zh": "公正世界谬误", "title_en": "Just-World Hypothesis", "category": "认知", "chapter": "09 群体心理与社会规范", "difficulty": "Medium", "xp": 25, "summary": "为了维持心理安全感，人们盲目相信“善恶必有报”，甚至因此对无辜受害者进行苛责。" },
    { "id": "LAW088", "title_zh": "刺猬效应", "title_en": "Hedgehog's Dilemma", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "人际关系过近会互相刺伤，过远则感到孤独，保持恰当心理边界才能维持长久亲密。" },
    { "id": "LAW089", "title_zh": "南风效应（温暖法则）", "title_en": "South Wind Law", "category": "社会", "chapter": "04 社会影响与人际说服", "difficulty": "Easy", "xp": 20, "summary": "强硬的指责如北风让人裹紧防备，温和的共情与感化如南风更能让人卸下心防。" },
    { "id": "LAW090", "title_zh": "情绪传染效应", "title_en": "Emotional Contagion", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Easy", "xp": 20, "summary": "借助镜像神经元系统，人们会无意识模仿他人的表情、语调并同步感染其情绪状态。" },
    { "id": "LAW091", "title_zh": "享乐跑步机（享乐适应）", "title_en": "Hedonic Treadmill", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "无论经历巨大惊喜还是挫折，人类的长期主观幸福感终会逐渐回落到稳定的基线水平。" },
    { "id": "LAW092", "title_zh": "情感预测偏误", "title_en": "Affective Forecasting Error", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "人们系统性高估未来某件好事或坏事给自己带来的情绪强度与持续时间（影响力偏误）。" },
    { "id": "LAW093", "title_zh": "习得性无助", "title_en": "Learned Helplessness", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Medium", "xp": 25, "summary": "经历反复不可控的挫败后，即使环境中出现了逃脱或改变的机会，个体也会放弃尝试。" },
    { "id": "LAW094", "title_zh": "白熊效应（讽刺性进程理论）", "title_en": "Ironic Process Theory", "category": "情绪", "chapter": "06 情绪调节与压力应对", "difficulty": "Easy", "xp": 20, "summary": "越是刻意压抑和命令自己“不要去想某件事”，大脑监控机制反而会让该念头更加频繁浮现。" },
    { "id": "LAW095", "title_zh": "心理逆反（罗密欧与朱丽叶效应）", "title_en": "Psychological Reactance", "category": "行为", "chapter": "10 自我认知与心智成长", "difficulty": "Easy", "xp": 20, "summary": "当个体感知到自身选择自由被强行剥夺或禁止时，会激发强烈的逆反抗拒并更渴望被禁事物。" },
    { "id": "LAW096", "title_zh": "自我决定理论", "title_en": "Self-Determination Theory", "category": "行为", "chapter": "10 自我认知与心智成长", "difficulty": "Medium", "xp": 25, "summary": "持久的内在动机源于三大基本心理需求的满足：自主感（Autonomy）、胜任感（Competence）与归属感（Relatedness）。" },
    { "id": "LAW097", "title_zh": "心流理论", "title_en": "Flow Theory", "category": "行为", "chapter": "10 自我认知与心智成长", "difficulty": "Easy", "xp": 20, "summary": "当任务挑战度与个人技能水平高度匹配且目标清晰、反馈即时时，人会进入忘我的巅峰心流体验。" },
    { "id": "LAW098", "title_zh": "成长型思维模式", "title_en": "Growth Mindset", "category": "认知", "chapter": "10 自我认知与心智成长", "difficulty": "Easy", "xp": 20, "summary": "相信智力与能力可通过刻意练习重塑的人，将挫折视为神经突触生长的信号而非能力否定。" },
    { "id": "LAW099", "title_zh": "元认知觉察", "title_en": "Metacognition", "category": "认知", "chapter": "10 自我认知与心智成长", "difficulty": "Medium", "xp": 25, "summary": "对自身思维过程的监控与调节能力（思考你的思考），是从直觉偏误跃迁至理性决策的总开关。" },
    { "id": "LAW100", "title_zh": "有限理性", "title_en": "Bounded Rationality", "category": "决策", "chapter": "10 自我认知与心智成长", "difficulty": "Hard", "xp": 30, "summary": "赫伯特·西蒙提出：受制于信息不完备、时间压力与大脑算力极限，人类追求的是“满意解”而非理论最优解。" }
  ]
}
